#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -f "$ROOT/.env" ]]; then
  echo "Falta $ROOT/.env. Copia .env.example y ajusta las rutas locales."
  exit 1
fi

if [[ ! -f "$ROOT/projects.yml" ]]; then
  cp "$ROOT/projects.example.yml" "$ROOT/projects.yml"
fi

if ! colima status >/dev/null 2>&1; then
  colima start
fi

docker context use colima >/dev/null

docker network inspect dev_proxy >/dev/null 2>&1 || docker network create dev_proxy

docker compose \
  --env-file "$ROOT/.env" \
  -f "$ROOT/traefik/docker-compose.yml" \
  -p local-infra \
  up -d --build

echo "Local infra lista."
echo "Traefik dashboard: http://localhost:8080/dashboard/"
echo "Control panel:     http://infra.localhost"
